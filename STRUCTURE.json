{\n  "directory_structure": {\n    "root": "kanserProjectData/",\n    "subdirectories": [\n      {\n        "path": "Data/",\n        "description": "Main data directory",\n        "subdirs": [\n          {\n            "name": "reports/",\n            "description": "Individual cancer report files (YAML)"\n          },\n          {\n            "name": "categories/",\n            "description": "Category definitions"\n          },\n          {\n            "name": "metadata/",\n            "description": "Metadata about the dataset"\n          }\n        ]\n      },\n      {\n        "path": "schemas/",\n        "description": "YAML schema definitions (optional, for validation)"\n      },\n      {\n        "path": "examples/",\n        "description": "Example YAML files for reference"\n      },\n      {\n        "path": "docs/",\n        "description": "Additional documentation"\n      },\n      {\n        "path": "scripts/",\n        "description": "Utility scripts for data processing"\n      }\n    ]\n  },\n  "file_naming_conventions": {\n    "report_files": {\n      "pattern": "YYYY-MM-DD-{id}-{short-description}.yaml",\n      "example": "2026-03-04-001-melanoma-severity-high.yaml",\n      "description": "Individual cancer report files with date, unique ID, and description"\n    },\n    "category_files": {\n      "pattern": "{category-name}.yaml",\n      "example": "skin-cancer-types.yaml",\n      "description": "Category definition files"\n    }\n  },\n  "yaml_field_standards": {\n    "description": "Standard structure for every cancer report",\n    "template": {\n      "id": "unique-identifier",\n      "date_reported": "YYYY-MM-DD",\n      "category": "cancer-type",\n      "severity": "low|medium|high|critical",\n      "location": {\n        "region": "body-region",\n        "precision": "approximate|exact",\n        "coordinates": {\n          "latitude": null,\n          "longitude": null\n        }\n      },\n      "description": "detailed description",\n      "attachments": [\n        {\n          "name": "filename",\n          "url": "path-or-link",\n          "type": "image|document|report"\n        }\n      ],\n      "metadata": {\n        "status": "active|archived|moderated",\n        "last_updated": "YYYY-MM-DD",\n        "contributor": "github-username"\n      }\n    }\n  },\n  "best_practices": [\n    "Version Control: Every change is tracked via Git",\n    "Validation: Use YAML linters before committing",\n    "Modularity: Keep reports separate for easy updates",\n    "Non-destructive: Archive records instead of deleting",\n    "Scalability: Structure allows migration to databases later"\n  ]\n}